# Copy outside the checkout, e.g. /root/secondhand-production.env; chmod 600.
# Do not copy your local .env. deploy.sh manages runtime/service settings.
APP_NAME="Second Hand"

# Private Cloudflare R2 or AWS S3 bucket. Disable public bucket access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Verified transactional SMTP account; delivery must be tested before launch.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Second Hand"

# Optional. Supply the EXISTING APP_KEY when restoring onto a new server.
# APP_KEY=base64:...
# CERTBOT_EMAIL=you@example.com
# ASSET_URL=https://assets.example.com
