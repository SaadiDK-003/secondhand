# Optional template for preparing settings before a non-interactive deployment.
# Normal sudo bash deploy.sh creates/protects root .env and asks for missing SMTP details.
# deploy.sh fills production/runtime/service settings.
APP_NAME="Second Hand"

# Private photos on this VPS, outside public/. No AWS account is needed.
LISTING_IMAGES_DISK=listing_images

# Existing Gmail SMTP account; use a newly generated app password.
# You can change these settings for another SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Second Hand"

# Optional private cloud storage: set LISTING_IMAGES_DISK=s3 and fill these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. Supply the EXISTING APP_KEY when restoring onto a new server.
# APP_KEY=base64:...
# CERTBOT_EMAIL=you@example.com
# ASSET_URL=https://assets.example.com
